
# NagarWatch backend — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL / PostGIS ---
# See README "Database setup" for how to create these.
PGHOST=localhost
PGPORT=5432
PGDATABASE=nagarwatch
PGUSER=nagarwatch_app
PGPASSWORD=change_me


# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GENERATE_ME
JWT_EXPIRES_IN=8h

# --- OpenRouter (LLM gateway for the AI query assistant) ---
OPENROUTER_API_KEY=generate_me
OPENROUTER_MODEL_PRIMARY=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL_FALLBACK=google/gemma-2-9b-it:free
